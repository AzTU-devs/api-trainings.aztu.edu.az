# Copy to .env (gitignored) for local runs; inject as real env vars in deployments.
# docker-compose.prod.yml reads this repo's .env directly via `env_file`.
#
# --- Profile ---
# dev  -> localhost DB fallbacks + db/dev seed accounts (Password123!)
# prod -> no defaults, no seeds, no Swagger, no error details. Docker images default to prod.
#
# Local runs only, so it is commented out: nothing here may pick the profile for a
# server. Uncommented, a copied .env would override the image's prod default under
# a plain `docker run --env-file` and start production with the seed SUPER_ADMIN,
# Swagger and every startup check off. docker-compose.prod.yml pins prod whatever
# this says. Locally you do not need it: ./mvnw spring-boot:run and
# docker-compose.yml both default to dev.
# SPRING_PROFILES_ACTIVE=dev

# --- Database (Postgres) ---
# REQUIRED outside the dev profile — startup fails if unset rather than guessing.
DATABASE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=5

# --- Server ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# --- Frontends / CORS ---
# Public site origin. Password-reset and e-mail-verification links and the OAuth
# redirect back after sign-in are built from it.
FRONTEND_PUBLIC_URL=http://localhost:3000
# Exact origins, comma-separated, scheme included, no trailing slash. Never `*` and
# never a wildcard such as https://*.aztu.edu.az: CORS here allows credentials, so
# every origin listed can call POST /api/auth/refresh with the portal's refresh
# cookie and read the new access token. The /ws handshake is checked against the
# same list, which is why production lists the dashboard origin too:
#   CORS_ALLOWED_ORIGINS=https://trainings.aztu.edu.az,https://dashboard-trainings.aztu.edu.az
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# --- JWT ---
JWT_ISSUER=eduplatform
# REQUIRED outside dev. Must be >= 32 bytes; generate with: openssl rand -base64 48
# Commented out rather than left as a placeholder: any value in this file is
# public, so a .env copied from it must not carry one. Startup outside dev refuses
# a missing value and any value containing "change-me", "dev-only" or "insecure"
# (and "change-me" in every profile). Local ./mvnw runs fall back to a dev-only
# key; docker-compose.yml requires you to set one.
# JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- Payments ---
# No payment provider is integrated. While this is false, order creation is refused with
# a typed error and the public catalogue serves FREE courses only — that is what stops a
# learner reaching a checkout that cannot charge them. Flip to true only after wiring a
# provider, and re-check the public catalogue and OrderService when you do.
PAYMENTS_ENABLED=false

# --- Rate limiting ---
# Per-IP token buckets on the unauthenticated auth endpoints (login, register, OTP
# start/verify, password forgot/reset). Off leaves them open to credential stuffing and
# OTP brute force; turn it off for a load test and nothing else.
RATE_LIMIT_ENABLED=true

# --- Mail ---
# While MAIL_ENABLED=false, OTP / e-mail-verification / password-reset messages are
# written to the log, body included, instead of being sent — so tutor sign-up and
# password reset do NOT work for real users, and the logs hold live OTPs and reset
# links. (That log line is also how the operator reads the admin-bootstrap OTP.)
# With MAIL_ENABLED=true a failed send logs only recipient and subject.
# The SMTP health indicator is off whatever this says, so turning mail on cannot
# make the container unhealthy — see DEPLOY.md, "Mail" and "Health".
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eduplatform.local

# --- OAuth: Google ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# --- OAuth: Facebook ---
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=

# --- OAuth: Apple (Sign in with Apple) ---
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=

# --- Storage ---
# LOCAL is the only provider with an implementation. STORAGE_PROVIDER=S3 is accepted and
# then ignored, because no S3 StorageService bean exists — see DEPLOY.md before choosing it.
STORAGE_PROVIDER=LOCAL
# Production path. The Dockerfile default, the image VOLUME and both compose mounts all
# use /opt/uploads; if this points anywhere that is not the mounted path, uploads land on
# the container layer and the next redeploy destroys them, silently. The host directory
# must be owned by uid/gid 1001 (the image's app user):
#   sudo mkdir -p /opt/uploads && sudo chown -R 1001:1001 /opt/uploads
# For a bare-metal local run (./mvnw spring-boot:run) use a writable repo path instead:
#   STORAGE_LOCAL_DIR=./var/uploads
STORAGE_LOCAL_DIR=/opt/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Upload ceilings (MB) ---
# Enforced server-side per media kind. Images and documents go multipart to
# POST /api/media, which spring.servlet.multipart.* caps at 32MB file / 40MB request —
# raise that too before taking IMAGE or DOCUMENT past 32. Video bypasses multipart
# (streamed with PUT /api/videos/{id}/content), so only VIDEO and nginx apply to it.
# nginx client_max_body_size (550m, admin portal and host api vhost) must sit above all
# of them: if it is the smaller, the uploader gets a bare 413 with no typed error to show.
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=512
UPLOAD_MAX_DOCUMENT_MB=25

# --- Logging ---
# INFO, which is also the prod profile's default. DEBUG writes request details to
# the logs; set it only on your own machine.
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN

# --- Time zone ---
# Day and month boundaries in analytics, and the days and hours room pricing rules
# are written in, use this zone rather than UTC.
APP_TIMEZONE=Asia/Baku

# --- Security / housekeeping ---
# Secure flag on the admin portal's refresh-token cookie: auto (every profile but dev),
# true or false. Only set it to false if you knowingly serve the portal over plain HTTP.
COOKIE_SECURE=auto
# Consecutive failed logins before an account auto-locks (unlock via the super-admin
# security view).
MAX_FAILED_LOGINS=5
# API request logs older than this are purged by the cleanup job.
API_LOG_RETENTION_DAYS=30
# When that job runs (Spring cron: second minute hour day month weekday). It also
# purges expired OTPs, OAuth states and stale refresh tokens. Hourly by default.
CLEANUP_CRON=0 0 * * * *

# --- Prod-only toggles (see application-prod.properties) ---
# Expose /swagger-ui.html and /v3/api-docs in prod. Off by default.
SWAGGER_ENABLED=false
# TRUST_FORWARD_HEADERS no longer exists and has no effect if set. The client IP now
# comes from Tomcat's RemoteIpValve (server.forward-headers-strategy=native), which
# trusts X-Forwarded-For only from loopback/private-range peers and reads it right to
# left — see DEPLOY.md, "Client IP". Keep port 8080 firewalled regardless.
#
# Admin self-registration is accepted only while this is true AND no ADMIN/SUPER_ADMIN
# exists yet. Set true, register the first admin, set false again
# (docs/operations/deployment.md §8).
ADMIN_SELF_REGISTER=false
