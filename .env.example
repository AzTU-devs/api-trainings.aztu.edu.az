# Copy to .env (gitignored) for local runs; inject as real env vars in deployments.
# docker-compose.prod.yml reads this repo's .env directly via `env_file`.
#
# --- Profile ---
# dev  -> localhost DB fallbacks + db/dev seed accounts (Password123!)
# prod -> no defaults, no seeds, no Swagger, no error details. Docker images default to prod.
SPRING_PROFILES_ACTIVE=dev

# --- Database (Postgres) ---
# REQUIRED outside the dev profile — startup fails if unset rather than guessing.
DATABASE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=5

# --- Server ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# --- Frontends / CORS ---
FRONTEND_PUBLIC_URL=http://localhost:3000
FRONTEND_PORTAL_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# --- JWT ---
JWT_ISSUER=eduplatform
# REQUIRED. Must be >= 32 bytes; generate with: openssl rand -base64 48
# Startup refuses any value containing "change-me", "dev-only" or "insecure" outside
# the dev profile, so this placeholder cannot reach a deployment by accident.
JWT_ACCESS_SECRET=change-me-to-a-long-random-base64-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- Payments ---
# No payment provider is integrated. While this is false, order creation is refused with
# a typed error and the public catalogue serves FREE courses only — that is what stops a
# learner reaching a checkout that cannot charge them. Flip to true only after wiring a
# provider, and re-check the public catalogue and OrderService when you do.
PAYMENTS_ENABLED=false

# --- Rate limiting ---
# Per-IP token buckets on the unauthenticated auth endpoints (login, register, OTP
# start/verify, password forgot/reset). Off leaves them open to credential stuffing and
# OTP brute force; turn it off for a load test and nothing else.
RATE_LIMIT_ENABLED=true

# --- Mail ---
# While MAIL_ENABLED=false, OTP / e-mail-verification / password-reset messages are
# written to the log instead of being sent — so admin bootstrap, tutor sign-up and
# password reset do NOT work for real users. It also keeps the SMTP health indicator
# disabled, which would otherwise report DOWN on blank credentials and stop the
# container from ever becoming healthy.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@eduplatform.local

# --- OAuth: Google ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# --- OAuth: Facebook ---
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=

# --- OAuth: Apple (Sign in with Apple) ---
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=

# --- Storage ---
# LOCAL is the only provider with an implementation. STORAGE_PROVIDER=S3 is accepted and
# then ignored, because no S3 StorageService bean exists — see DEPLOY.md before choosing it.
STORAGE_PROVIDER=LOCAL
# Production path. The Dockerfile default, the image VOLUME and both compose mounts all
# use /opt/uploads; if this points anywhere that is not the mounted path, uploads land on
# the container layer and the next redeploy destroys them, silently. The host directory
# must be owned by uid/gid 1001 (the image's app user):
#   sudo mkdir -p /opt/uploads && sudo chown -R 1001:1001 /opt/uploads
# For a bare-metal local run (./mvnw spring-boot:run) use a writable repo path instead:
#   STORAGE_LOCAL_DIR=./var/uploads
STORAGE_LOCAL_DIR=/opt/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Upload ceilings (MB) ---
# Enforced server-side per media kind. These three numbers, spring.servlet.multipart.*
# (512MB) and the admin portal's nginx client_max_body_size (550m) have to agree: if
# nginx is the smaller of them, the uploader gets a bare 413 with no typed error to show.
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=512
UPLOAD_MAX_DOCUMENT_MB=25

# --- Logging ---
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=WARN

# --- Security / housekeeping ---
# Secure flag on the admin portal's refresh-token cookie: auto (every profile but dev),
# true or false. Only set it to false if you knowingly serve the portal over plain HTTP.
COOKIE_SECURE=auto
# Consecutive failed logins before an account auto-locks (unlock via the super-admin
# security view).
MAX_FAILED_LOGINS=5
# API request logs older than this are purged by the cleanup job.
API_LOG_RETENTION_DAYS=30

# --- Prod-only toggles (see application-prod.properties) ---
# Expose /swagger-ui.html and /v3/api-docs in prod. Off by default.
SWAGGER_ENABLED=false
# Trust X-Forwarded-* — true only when the app's port is reachable exclusively through a
# reverse proxy you control. Otherwise callers spoof their source IP straight past the
# IP blocklist, the rate limiter and audit attribution.
TRUST_FORWARD_HEADERS=true
# Allow the first admin to self-register. Turn off again once bootstrapped.
ADMIN_SELF_REGISTER=false
